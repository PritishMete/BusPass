<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:duration="300" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="360"
                android:valueTo="0"
                android:duration="300" />
        </set>
    </item>
</selector>
