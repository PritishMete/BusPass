<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F4F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/non_map_views"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:cardCornerRadius="22dp"
                android:backgroundTint="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp" android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_bg1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:background="@drawable/your_profile_header_background"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_picture"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="USER NAME"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginStart="24dp"
                        app:layout_constraintStart_toEndOf="@+id/profile_picture"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/profile_picture"
                        app:layout_constraintBottom_toBottomOf="@+id/profile_picture" />

                    <ImageView
                        android:id="@+id/imgcircle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/circles"
                        android:alpha="0.3"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp" android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/icon_edit_save_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_pencil"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_marginLeft="322dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBaseline="@id/label_email_title_static"
                    android:contentDescription="Edit Profile" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp">



                    <TextView
                        android:id="@+id/label_email_title_static"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="14sp"
                        android:textColor="@color/grey_text_color"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"/>

                    <LinearLayout
                        android:id="@+id/profile_fields_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_below="@id/label_email_title_static"
                        android:layout_marginTop="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">
                            <ImageView
                                android:id="@+id/icon_email"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_email_placeholder"
                                app:tint="@color/icon_tint_color"
                                android:layout_marginEnd="12dp"/>
                            <EditText
                                android:id="@+id/email_text_view"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="Give us your email. The carrier pigeon retired."
                                android:textSize="15sp"
                                android:textColor="@color/black"
                                android:background="@null"
                                android:inputType="textEmailAddress"/>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone"
                            android:textSize="14sp"
                            android:textColor="@color/grey_text_color" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp">
                            <ImageView
                                android:id="@+id/icon_phone"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_phone_placeholder"
                                app:tint="@color/icon_tint_color"
                                android:layout_marginEnd="12dp"/>
                            <EditText
                                android:id="@+id/phone_number_text_view"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="+91 9876543210"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:background="@null"
                                android:inputType="phone"/>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="City"
                            android:textSize="14sp"
                            android:textColor="@color/grey_text_color" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp">
                            <ImageView
                                android:id="@+id/icon_city"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_city_placeholder"
                                app:tint="@color/icon_tint_color"
                                android:layout_marginEnd="12dp"/>
                            <EditText
                                android:id="@+id/citydetail"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="Where on Earth are you?"
                                android:textSize="15sp"
                                android:textColor="@color/black"
                                android:background="@null"
                                android:inputType="textCapWords"/>
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date of Birth"
                            android:textSize="14sp"
                            android:textColor="@color/grey_text_color" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:id="@+id/icon_dob"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_calendar_placeholder"
                                app:tint="@color/icon_tint_color"
                                android:layout_marginEnd="12dp"/>
                            <EditText
                                android:id="@+id/dob_text_view"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="Just your DOB. Cake not included."
                                android:textSize="15sp"
                                android:textColor="@color/black"
                                android:background="@null"
                                android:focusable="false" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp" app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp" android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/buttons_2x2_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="16dp" android:paddingEnd="8dp"
                        android:paddingBottom="16dp"> <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp" android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/helpButton"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="75dp"
                            android:text="Help"
                            android:textAllCaps="false"
                            android:textColor="@color/text_color_dark"
                            android:backgroundTint="@color/white"
                            app:icon="@drawable/ic_help_placeholder"
                            app:iconTint="@color/button_blue_color"
                            app:iconGravity="textStart"
                            app:iconSize="52dp" app:iconPadding="12dp"
                            app:strokeColor="@color/divider_color"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textAlignment="viewStart"
                            android:layout_marginEnd="6dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/offersButton"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:minHeight="75dp"
                            android:text="Offers"
                            android:textAllCaps="false"
                            android:textColor="@color/text_color_dark"
                            android:backgroundTint="@color/white"
                            app:icon="@drawable/ic_offers_placeholder"
                            app:iconTint="@color/button_blue_color"
                            app:iconGravity="textStart"
                            app:iconSize="52dp" app:iconPadding="16dp"
                            app:strokeColor="@color/divider_color"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textAlignment="viewStart"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/referralButton"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:minHeight="75dp"
                                android:text="Referral"
                                android:textAllCaps="false"
                                android:textColor="@color/text_color_dark"
                                android:backgroundTint="@color/white"
                                app:icon="@drawable/ic_referral_placeholder"
                                app:iconTint="@color/button_blue_color"
                                app:iconGravity="textStart"
                                app:iconSize="52dp" app:iconPadding="12dp"
                                app:strokeColor="@color/divider_color"
                                app:strokeWidth="1dp"
                                app:cornerRadius="12dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textAlignment="viewStart"
                                android:layout_marginEnd="6dp"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/technicalIssueButton"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:minHeight="75dp"
                                android:text="Issue"
                                android:textAllCaps="false"
                                android:textColor="@color/text_color_dark"
                                android:backgroundTint="@color/white"
                                app:icon="@drawable/ic_issue_placeholder"
                                app:iconTint="@color/button_blue_color"
                                app:iconGravity="textStart"
                                app:iconSize="52dp" app:iconPadding="22dp"
                                app:strokeColor="@color/divider_color"
                                app:strokeWidth="1dp"
                                app:cornerRadius="12dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textAlignment="viewStart"
                                android:layout_marginStart="6dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textColor="@color/logout_red_color"
                    android:textSize="16sp"
                    app:strokeColor="@color/logout_red_color"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/white"
                    app:cornerRadius="28dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
