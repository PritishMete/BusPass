<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_day_name_in_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/darker_gray"
        android:textSize="15sp"
        tools:text="Monday, Apr 21"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_item_count_column_start"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_bias="0.0"
        android:layout_marginEnd="16dp"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_item_count_column_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="221dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_amount_column_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6618005" />


    <TextView
        android:id="@+id/tv_day_total_incentive_in_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="+₹175.00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_day_item_count_in_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/redd" android:textSize="14sp"
        android:textStyle="bold"
        tools:text="(3 items)"
        app:layout_constraintEnd_toStartOf="@+id/guideline_amount_column_start"
        app:layout_constraintTop_toTopOf="@+id/tv_day_total_incentive_in_week"
        app:layout_constraintBottom_toBottomOf="@+id/tv_day_total_incentive_in_week"
        android:layout_marginEnd="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>