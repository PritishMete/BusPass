<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0E0E0"
    tools:context=".UserWalletRechargeActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/rechargeWalletTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RECHARGE WALLET"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/enterAmountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Amount (₹)"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/rechargeAmountEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:padding="16dp"
                    android:background="@drawable/edittext_rounded_border_bg"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/payWithGooglePayButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/googlePayLogo"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_google_pay_logo"
                            android:contentDescription="GooglePay Logo"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pay via GooglePay"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:layout_marginStart="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/payWithAmazonPayButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/amazonPayLogo"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_amazon_pay_logo"
                            android:contentDescription="Amazon Pay Logo"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pay via Amazon Pay"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:layout_marginStart="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/payWithpaytm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/paytmLogo"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_paytm_logo"
                            android:contentDescription="Paytm Logo"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pay via Paytm"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:layout_marginStart="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/payWithPhonePeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/phonePeLogo"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_phonepe_logo"
                            android:contentDescription="PhonePe Logo"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pay via PhonePe"
                            android:textSize="16sp"
                            android:textColor="@android:color/black"
                            android:layout_marginStart="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/rechargeViaUpiLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recharge via UPI ID"
                    android:textSize="16sp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/upiIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter UPI ID to pay (Optional)"
                    android:inputType="textEmailAddress"
                    android:padding="16dp"
                    android:background="@drawable/edittext_rounded_border_bg"
                    android:textSize="16sp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chooseAnotherUpiAppButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose another UPI app"
                    android:textColor="#424242"
                    app:strokeColor="#BDBDBD"
                    app:cornerRadius="12dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/payWithDebitCardButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pay with razorpay "
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1976D2"
                    app:icon="@drawable/ic_debit_card_white"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:cornerRadius="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>