<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_week_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="May 19 - 25, 2025 (This Week)"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline_item_count_column_start"
            app:layout_constraintHorizontal_bias="0.0"
            android:layout_marginEnd="8dp"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_item_count_column_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="221dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_amount_column_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="123dp" />

        <TextView
        android:id="@+id/tv_week_total_item_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="(25 items)"
        android:textColor="@color/redd" android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="end"
        app:layout_constraintStart_toStartOf="@id/guideline_item_count_column_start"
        app:layout_constraintEnd_toStartOf="@id/guideline_amount_column_start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tv_week_total_incentive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="+₹1607.61"
            android:textColor="@color/master_blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end"
            app:layout_constraintStart_toStartOf="@id/guideline_amount_column_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="4dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>