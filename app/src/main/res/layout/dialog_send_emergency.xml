<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_send_emergency.xml -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@android:color/white">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 Send Emergency Report"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="@color/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emergency_title_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Emergency Title"
                android:maxLines="1"
                android:inputType="text"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Content Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/colorPrimary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="@color/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emergency_content_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe the emergency situation..."
                android:maxLines="5"
                android:minLines="3"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Severity Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Severity Level:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="#1A1A1A" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8F9FA">

            <RadioGroup
                android:id="@+id/severity_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/severity_low"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Low"
                    android:textColor="@color/severity_low"
                    android:textSize="14sp"
                    android:buttonTint="@color/severity_low"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/severity_medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:checked="true"
                    android:textColor="@color/severity_medium"
                    android:textSize="14sp"
                    android:buttonTint="@color/severity_medium"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/severity_high"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="High"
                    android:textColor="@color/severity_high"
                    android:textSize="14sp"
                    android:buttonTint="@color/severity_high"
                    android:padding="8dp" />

            </RadioGroup>

        </androidx.cardview.widget.CardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/cancel_emergency_btn"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginEnd="12dp"
                android:minWidth="0dp"
                android:paddingHorizontal="20dp" />

            <Button
                android:id="@+id/send_emergency_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send Emergency Report"
                android:textSize="14sp"
                android:backgroundTint="@color/colorPrimary"
                app:cornerRadius="20dp"
                android:minWidth="0dp"
                android:paddingHorizontal="20dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>