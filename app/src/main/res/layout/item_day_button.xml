<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="60dp"
    android:layout_height="70dp"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_margin="4dp"
    android:padding="8dp"
    android:background="@drawable/day_button_selector"
    android:clickable="true"
    android:focusable="true">

    <TextView android:id="@+id/tv_day_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" tools:text="23"/>
    <TextView android:id="@+id/tv_month_abbr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" tools:text="Jun"/>
    <TextView android:id="@+id/tv_day_name_abbr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" tools:text="Sat"/>
</LinearLayout>