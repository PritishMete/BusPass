<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0FE"> <com.airbnb.lottie.LottieAnimationView
    android:id="@+id/lottieAnimationVerified"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:visibility="gone"
    app:layout_constraintBottom_toTopOf="@+id/guideline_top_card"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0.6"
    app:lottie_autoPlay="false"
    app:lottie_loop="false"
    app:lottie_rawRes="@raw/ticketverification" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimationInvalid"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/guideline_top_card"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="0.6"
    app:lottie_autoPlay="false"
    app:lottie_loop="false"
    app:lottie_rawRes="@raw/ticketfailed" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25" />

    <TextView
        android:id="@+id/qrScannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR\nSCANNER"
        android:textColor="#1E3A8A"
        android:textSize="34sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/qr_icon"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginTop="32dp"/>

    <ImageView
        android:id="@+id/qr_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_qr_code_scanner_icon"
        app:tint="#1E3A8A"
        app:layout_constraintStart_toEndOf="@+id/qrScannerTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/qrScannerTitle"
        app:layout_constraintBottom_toBottomOf="@+id/qrScannerTitle"
        android:layout_marginStart="16dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/content_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/qrScannerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@android:color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <Button
                android:id="@+id/startScanButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:text="Start Scanning"
                android:background="@drawable/user_home_rounded_blue_button_ripple_bg"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textAllCaps="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/scanResultTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Result will be shown here"
                android:textSize="16sp"
                android:textColor="#4A4A4A"
                android:background="@drawable/result_text_background"
                android:padding="16dp"
                android:gravity="center"
                android:minHeight="80dp"
                app:layout_constraintTop_toBottomOf="@+id/startScanButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/scanCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans Today: 0"
                android:textSize="16sp"
                android:textColor="#4A4A4A"
                app:layout_constraintTop_toBottomOf="@+id/scanResultTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="24dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
