<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTransactionType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Debit"
            tools:background="@drawable/bg_debit_tag"/>
        <TextView
            android:id="@+id/tvTransactionAmountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount :"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTransactionType"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTransactionAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/tvTransactionAmountLabel"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTransactionAmountLabel"
            tools:text="- ₹20.0"/>

        <TextView
            android:id="@+id/tvBalanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance :"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTransactionAmountLabel"
            app:layout_constraintEnd_toStartOf="@id/tvTransactionBalance"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvTransactionBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvBalanceLabel"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="₹27.95"/>

        <TextView
            android:id="@+id/tvTransactionTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Txn Time :"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTransactionAmountLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTransactionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/tvTransactionTimeLabel"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTransactionTimeLabel"
            tools:text="22/05/2025 09:00:31"/>

        <TextView
            android:id="@+id/tvRemarkLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remark :"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTransactionTimeLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTransactionRemark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@id/tvRemarkLabel"
            app:layout_constraintBaseline_toBaselineOf="@id/tvRemarkLabel"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Tkt Booking"/>

        <TextView
            android:id="@+id/tvBookingDetailsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ticket Information:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTransactionRemark"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/tvRelatedBookingId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvBookingDetailsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Booking ID: BK12345678"/>

        <TextView
            android:id="@+id/tvBookingRoute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvRelatedBookingId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Route: 7A - Howrah to Esplanade"/>

        <TextView
            android:id="@+id/tvBookingStops"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvBookingRoute"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="From: Howrah Maidan To: Park Street"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>