<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg_rounded_white"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:elevation="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:maxHeight="500dp">

    <EditText
        android:id="@+id/search_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_search_bar_background"
        android:drawableStart="@drawable/ic_user_map_search"
        android:drawablePadding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:hint="Search stops..."
        android:textColorHint="@color/dialog_search_text_hint_color"
        android:textColor="@android:color/black"
        android:textSize="17sp"
        android:layout_marginBottom="16dp"
        android:inputType="text"
        android:maxLines="1"
        app:drawableTint="@color/dialog_search_icon_tint" />

    <TextView
        android:id="@+id/nearest_stops_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick a Bus Stop to Board"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nearestStopsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Close"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/dialog_button_blue"
        app:cornerRadius="16dp"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:elevation="2dp"/>

</LinearLayout>