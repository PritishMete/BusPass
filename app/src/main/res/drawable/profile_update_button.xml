<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background layer -->
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <gradient android:startColor="#0b1934"
                android:endColor="#0b1934"
                android:type="linear"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>

    <!-- Icon layer -->
    <item android:drawable="@drawable/profileupdate" android:gravity="center" android:right="100dp"/>
</layer-list>