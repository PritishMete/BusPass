<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
  <!-- Define the solid background (transparent) -->
  <solid android:color="@android:color/transparent" />

  <!-- Define the dashed stroke -->
  <stroke
      android:color="#2196F3"
  android:width="4dp"
  android:dashWidth="30dp"
  android:dashGap="8dp" />

  <!-- Define padding to ensure proper spacing -->
  <padding
      android:left="4dp"
      android:top="4dp"
      android:right="4dp"
      android:bottom="4dp" />
</shape>
