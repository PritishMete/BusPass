<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item android:right="4dp" android:left="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#80000000"/> <!-- Shadow color -->
            <corners android:radius="16dp"/> <!-- Adjust corner radius as needed -->
        </shape>
    </item>
    <!-- Neumorphic Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D2DFEB"/> <!-- Background color -->
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
