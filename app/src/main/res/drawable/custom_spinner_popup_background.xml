<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer for Popup -->
    <item android:right="5dp" android:left="5dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#80000000"/> <!-- Shadow color -->
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <!-- Popup Neumorphic Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/twelfthline"/> <!-- Popup background color -->
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
