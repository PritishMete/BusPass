<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Add these new permissions for background service and newer Android versions -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- For profile picture handling -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- For Android 9+ background restrictions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="org.npci.upiapp" />
        <package android:name="com.csam.icici.bank" />
        <package android:name="com.axis.mobile" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartBuss"
        tools:targetApi="31"
        tools:ignore="ScreenOrientation">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wallet_notifications"/>

        <service
            android:name=".LocationUpdateService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name=".BluetoothService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />


        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.SmartBuss"
            android:screenOrientation="portrait"
            android:exported="false"
            android:launchMode="singleTop">
        </activity>

        <activity
            android:name=".AuthActivity"
            android:theme="@style/Theme.SmartBuss"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"

            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SplashScreen"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:label="Splash Screen"
            android:exported="true" />

        <activity
            android:name=".HelpActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:label="Splash Screen"
            android:exported="true" />

        <activity
            android:name=".ReferralActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:label="Splash Screen"
            android:exported="true" />
        <activity
            android:name=".IssueActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:label="Splash Screen"
            android:exported="true" />
        <activity
            android:name=".conductor_map"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:label="Splash Screen"
            android:exported="true" />


        <activity
            android:name=".forgot"
            android:theme="@style/Theme.SmartBuss"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".user_showticket"
            android:theme="@style/Theme.SmartBuss"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".WalletPassbookActivity"
            android:label="Passbook"
            android:screenOrientation="portrait"
            android:exported="false"
            android:parentActivityName=".user_menu" />
        <activity
            android:name=".savedroute"
            android:label="Passbook"
            android:screenOrientation="portrait"
            android:exported="false"
            android:parentActivityName=".user_menu" />
        <receiver
            android:name=".TicketBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pritish.smartbuss.TICKET_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <activity android:name=".user_menu" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".bus_location" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".user_select_journey" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".conductor_menu" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".user_map" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".user_map_others" android:screenOrientation="portrait" android:exported="false" />


        <activity
            android:name=".UserWalletRechargeActivity"
            android:label="Recharge Wallet"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SmartBuss"
            android:exported="false" />

        <activity android:name=".PassengerListActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".QRScannerActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".BookingActivity" android:screenOrientation="portrait" android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".BookingActivity_others" android:screenOrientation="portrait" android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".razorpaypayment" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".conductor_current_booking" android:screenOrientation="portrait" android:exported="false" />

        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.AppCompat.DayNight"/>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />
    </application>

</manifest>